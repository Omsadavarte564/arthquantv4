# GEMINI_API_KEY: Required for Gemini AI API calls (signal explanations, daily market reports).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional External Python ML Service (Cloud Run / FastAPI)
# Leave unset to run local deterministic TypeScript quantitative engine
ML_SERVICE_URL=""
ML_SERVICE_TOKEN=""

# Optional Broker Adapter Credentials (Server-side only — never expose to client)
# Live execution remains disabled unless regulatory & compliance checks pass
ZERODHA_API_KEY=""
ZERODHA_API_SECRET=""
UPSTOX_API_KEY=""
UPSTOX_API_SECRET=""
DHAN_CLIENT_ID=""
DHAN_ACCESS_TOKEN=""
ANGELONE_API_KEY=""
ANGELONE_CLIENT_CODE=""

# Mobile Trade Notifications (Telegram Bot - 100% Free)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Optional WhatsApp Alerts (CallMeBot Free API)
WHATSAPP_PHONE=""
WHATSAPP_API_KEY=""

# Required to manage alert subscribers and send manual broadcasts
# Use a unique random value of at least 32 characters; keep it private.
ALERTS_ADMIN_TOKEN=""

# Required to enable TradingView webhook actions
# Use a different unique random value of at least 32 characters.
TRADINGVIEW_WEBHOOK_SECRET=""
